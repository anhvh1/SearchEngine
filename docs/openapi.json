        "title": "Body_transcribe_api_transcribe_post"
      },
      "Envelope": {
        "properties": {
          "site_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Site Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "event",
              "alarm"
            ],
            "title": "Kind"
          },
          "source_guid": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Guid"
          },
          "source_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Id"
          },
          "event_type": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Event Type"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "message": {
            "type": "string",
            "maxLength": 16000,
            "title": "Message",
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 32000,
            "title": "Description",
            "default": ""
          },
          "state": {
            "type": "string",
            "maxLength": 128,
            "title": "State",
            "default": ""
          },
          "priority": {
            "type": "string",
            "maxLength": 128,
            "title": "Priority",
            "default": ""
          },
          "camera_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Id"
          },
          "location": {
            "type": "string",
            "maxLength": 512,
            "title": "Location",
            "default": ""
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site_id",
          "kind",
          "source_guid",
          "source_id",
          "event_type",
          "occurred_at",
          "updated_at"
        ],
        "title": "Envelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Mapping": {
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]{0,255}$",
            "title": "Path"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ],
            "title": "Type",
            "default": "string"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": false
          },
          "enum": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Enum"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path"
        ],
        "title": "Mapping"
      },
      "Profile": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": -1000.0,
            "title": "Priority",
            "default": 0
          },
          "match": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Match"
          },
          "mapping": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Mapping"
            },
            "type": "object",
            "maxProperties": 64,
            "title": "Mapping"
          },
          "family": {
            "type": "string",
            "maxLength": 128,
            "title": "Family",
            "default": "unclassified"
          },
          "context": {
            "type": "string",
            "maxLength": 4000,
            "title": "Context",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
